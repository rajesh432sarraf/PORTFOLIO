# NOTE: Server-only secrets must NEVER be prefixed with VITE_ or committed to Git.

# MongoDB Configuration (Server-side Contact Submissions)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio

# MySQL Relational Database (Server-side Structured Content)
MYSQL_DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<database>

# Supabase Auth & Storage Configuration
# Client-safe keys:
VITE_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=<your-public-anon-key>

# Server-only Supabase Key:
SUPABASE_SERVICE_ROLE_KEY=<your-server-service-role-key>

# Email Notifications (Resend API)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=portfolio@rajeshsarraf.dev
CONTACT_NOTIFICATION_EMAIL=sarrafrajesh13@gmail.com

# Optional Client-side Form Service (Alternative to Resend)
VITE_PUBLIC_WEB3FORMS_KEY=
